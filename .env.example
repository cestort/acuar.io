# Copia este fichero a .env y ajusta los valores.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambia-esto
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen con el que accedes desde el móvil a través de la VPN, p. ej. http://10.8.0.1:8000
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ruta del fichero SQLite (en Docker, dentro del volumen persistente)
SQLITE_PATH=data/db.sqlite3

TIME_ZONE=Europe/Madrid
